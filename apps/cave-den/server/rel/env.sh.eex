#!/bin/sh
# The release's environment, for `bin/den start` and for `bin/den rpc` alike.
#
# Erlang distribution is how `bin/den rpc` (the host's commands) reaches the
# running den. It listens on loopback only, never on the server's public
# addresses, and its cookie is this den's own: RELEASE_COOKIE if set, or one
# made on first boot and kept beside the database (0600). Never the cookie a
# build bakes in, which every copy of a public image would share.
export ERL_EPMD_ADDRESS=127.0.0.1
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_use_interface {127,0,0,1}"

if [ -z "${RELEASE_COOKIE:-}" ]; then
  data_dir=$(dirname "${DATABASE_PATH:-/var/lib/den/den.db}")
  cookie_file=${DEN_COOKIE_FILE:-$data_dir/cookie}
  if [ ! -s "$cookie_file" ] && [ -d "$data_dir" ] && [ -w "$data_dir" ]; then
    (umask 077 && head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$cookie_file")
  fi
  if [ -s "$cookie_file" ]; then
    RELEASE_COOKIE=$(cat "$cookie_file")
    export RELEASE_COOKIE
  else
    echo "den: no cookie: set RELEASE_COOKIE, or give the den a writable $data_dir" >&2
    exit 1
  fi
fi
