/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' chrome-extension: moz-extension: safari-web-extension:; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src https://zyn-rpc.cavebro.win; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate
